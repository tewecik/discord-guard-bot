[Unit]
Description=Tewecik Discord Guard
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=tewecik-guard
Group=tewecik-guard
WorkingDirectory=/opt/tewecik-guard
EnvironmentFile=/opt/tewecik-guard/.env
ExecStart=/usr/local/bin/node /opt/tewecik-guard/dist/src/main.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=25
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tewecik-guard/data
UMask=0077

[Install]
WantedBy=multi-user.target
