{
  "name": "tewecik-guard",
  "description": "Tewecik Guard: configurable Discord security, raid protection and encrypted recovery backups.",
  "author": "tewecik",
  "homepage": "https://github.com/tewecik/discord-guard-bot#readme",
  "repository": { "type": "git", "url": "https://github.com/tewecik/discord-guard-bot.git" },
  "bugs": { "url": "https://github.com/tewecik/discord-guard-bot/issues" },
  "keywords": ["discord", "discord-bot", "guard", "moderation", "security", "typescript"],
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=26.12.0 <27" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/src/main.js",
    "register": "node --env-file=.env dist/src/register.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "tsc --noEmit",
    "keygen": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64'))\""
  },
  "dependencies": { "discord.js": "14.27.0", "zod": "4.6.7" },
  "devDependencies": { "@types/node": "26.6.5", "typescript": "5.9.3" }
}
